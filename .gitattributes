# https://github.com/Unity-Technologies/Game-Simulation-Match-3-Sample/blob/dev/.gitattributes
* text=auto

# Unity insists using LF for its text assets so prevent changing them to CRLF
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.json text eol=lf
*.mat text eol=lf
*.mesh text eol=lf
*.txt text eol=lf

# Git LFS keeps binary assets out of the repo history as pointers.
# GitHub Desktop bundles git-lfs, so it works there with no setup.
# Terminal users: brew install git-lfs && git lfs install
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
